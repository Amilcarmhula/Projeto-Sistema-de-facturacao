<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="410.0" prefWidth="900.0" spacing="10.0" styleClass="tranp-bg" stylesheets="@../../../../style/dashboard.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jminvsm.views.modulo_venda.clienteView.clienteAdd.AddClienteController">
   <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0" /></padding>
   <children>
      <HBox alignment="CENTER_LEFT"><children><Label fx:id="labHeadTitleEndereco" text="Endereços"><font><Font name="System Bold" size="20.0" /></font></Label><Region HBox.hgrow="ALWAYS" /><Button fx:id="btnEnderecoView" mnemonicParsing="false" onAction="#addConAddView" text="+ Novo endereço" /></children></HBox>
      <Separator />
      <SplitPane dividerPositions="0.35" VBox.vgrow="ALWAYS">
         <items>
            <ListView fx:id="listaEnderecosView" onMouseClicked="#selecionaEndereco" />
            <VBox spacing="10.0">
               <children>
                  <GridPane hgap="10.0" vgap="10.0">
                     <columnConstraints><ColumnConstraints minWidth="105.0" /><ColumnConstraints hgrow="ALWAYS" /><ColumnConstraints minWidth="85.0" /><ColumnConstraints hgrow="ALWAYS" /></columnConstraints>
                     <children>
                        <Label text="ID" GridPane.rowIndex="0" /><TextField fx:id="txtIDEndereco" alignment="CENTER" editable="false" maxWidth="105.0" promptText="ID" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Tipo" GridPane.columnIndex="2" GridPane.rowIndex="0" /><ComboBox fx:id="combTipoEndereco" maxWidth="1.7976931348623157E308" promptText="Tipo de endereço" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        <Label text="Província" GridPane.rowIndex="1" /><ComboBox fx:id="combProvincia" maxWidth="1.7976931348623157E308" promptText="Província" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
                        <Label text="Cidade" GridPane.rowIndex="2" /><TextField fx:id="txtCidade" promptText="Cidade" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Bairro" GridPane.columnIndex="2" GridPane.rowIndex="2" /><TextField fx:id="txtBairro" promptText="Bairro" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                        <Label text="Avenida" GridPane.rowIndex="3" /><TextField fx:id="txtAvenida" promptText="Avenida" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Rua" GridPane.columnIndex="2" GridPane.rowIndex="3" /><TextField fx:id="txtRua" promptText="Rua" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                        <Label text="Código postal" GridPane.rowIndex="4" /><TextField fx:id="txtCodigooPostal" promptText="Código postal" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <Label text="Número" GridPane.columnIndex="2" GridPane.rowIndex="4" /><TextField fx:id="txtNumeroEndereco" promptText="Número" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                        <Label text="Finalidade" GridPane.rowIndex="5" /><HBox spacing="16.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5"><children><RadioButton fx:id="radEnvio" text="Envio" /><RadioButton fx:id="radFacturacao" text="Facturação" /></children></HBox>
                     </children>
                  </GridPane>
                  <HBox alignment="CENTER_RIGHT" spacing="8.0"><children><Button fx:id="btnDeleteEndereco" onAction="#deleteEndereco" text="Remover" /><Button fx:id="btnAddEndereco" onAction="#addORupdateEndereco" styleClass="secondary-color" text="Guardar endereço" textFill="WHITE" /></children></HBox>
               </children>
            </VBox>
         </items>
      </SplitPane>
   </children>
</VBox>
