                                                                <TextField fx:id="txtCidade" promptText="Cidade" styleClass="text-squared-border" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                                <Label text="Bairro" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                                                <TextField fx:id="txtBairro" promptText="Bairro" styleClass="text-squared-border" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                                                <Label text="Avenida" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                                <TextField fx:id="txtAvenida" promptText="Avenida" styleClass="text-squared-border" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                                <Label text="Rua" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                                                <TextField fx:id="txtRua" promptText="Rua" styleClass="text-squared-border" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                                                                <Label text="Cód. postal" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                                                <TextField fx:id="txtCodigooPostal" promptText="0" styleClass="text-squared-border" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                                                <Label text="Número" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                                                                <TextField fx:id="txtNumeroEndereco" promptText="0" styleClass="text-squared-border" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                                                            </children>
