import java.awt.*;
import java.awt.print.*;
import java.util.ArrayList;
import java.util.List;

public class ImpressaoRecibo implements Printable {

    private final List&lt;Item&gt; itens;
    private final String titulo;
    private final String total;

    public ImpressaoRecibo(String titulo, List&lt;Item&gt; itens) {
        this.titulo =3D titulo;
        this.itens =3D itens;
        this.total =3D calcularTotal();
    }

    // Classe para representar os itens do recibo
    static class Item {
        String nome;
        int quantidade;
        double preco;

        public Item(String nome, int quantidade, double preco) {
            this.nome =3D nome;
            this.quantidade =3D quantidade;
            this.preco =3D preco;
        }
    }

    @Override
    public int print(Graphics g, PageFormat pf, int pageIndex) {
        if (pageIndex &gt; 0) return NO_SUCH_PAGE;

        Graphics2D g2d =3D (Graphics2D) g;
        g2d.translate(pf.getImageableX(), pf.getImageableY());

        int y =3D 20;

        // --- Centralizar t=C3=ADtulo ---
        Font fonteTitulo =3D new Font("Arial", Font.BOLD, 14);
        g.setFont(fonteTitulo);
        FontMetrics fm =3D g.getFontMetrics(fonteTitulo);
        int larguraTitulo =3D fm.stringWidth(titulo);
        int centroPagina =3D (int) pf.getImageableWidth() / 2;
        g.drawString(titulo, centroPagina - (larguraTitulo / 2), y);
        y +=3D 30;

        // --- Cabe=C3=A7alho da tabela ---
        Font fonteCabecalho =3D new Font("Arial", Font.BOLD, 12);
        g.setFont(fonteCabecalho);
        g.drawString("Produto", 10, y);
        g.drawString("Qtd", 200, y);
        g.drawString("Pre=C3=A7o", 250, y);
        y +=3D 15;

        // Linha separadora
        g.drawLine(10, y, 300, y);
        y +=3D 15;

        // --- Lista de itens ---
        Font fonteItens =3D new Font("Arial", Font.PLAIN, 12);
        g.setFont(fonteItens);
        for (Item item : itens) {
            g.drawString(item.nome, 10, y);
            g.drawString(String.valueOf(item.quantidade), 200, y);
            g.drawString(String.format("R$ %.2f", item.preco), 250, y);
            y +=3D 15;
        }

        y +=3D 10;
        g.drawLine(10, y, 300, y);
        y +=3D 20;

        // --- Total ---
        Font fonteTotal =3D new Font("Arial", Font.BOLD, 12);
        g.setFont(fonteTotal);
        g.drawString("TOTAL: " + total, 200, y);

        return PAGE_EXISTS;
    }

    private String calcularTotal() {
        double soma =3D 0;
        for (Item item : itens) {
            soma +=3D item.preco * item.quantidade;
        }
        return String.format("R$ %.2f", soma);
    }

    public static void main(String[] args) {
        // Lista din=C3=A2mica de itens
        List&lt;Item&gt; itens =3D new ArrayList&lt;&gt;();
        itens.add(new Item("Produto A", 2, 10.00));
        itens.add(new Item("Produto B", 1, 25.00));
        itens.add(new Item("Produto C", 3, 5.50));

        PrinterJob job =3D PrinterJob.getPrinterJob();
        job.setPrintable(new ImpressaoRecibo("Recibo de Pagamento", itens))=
;

        if (job.printDialog()) {
            try {
                job.print();
            } catch (PrinterException e) {
                e.printStackTrace();
            }
        }
    }
}
