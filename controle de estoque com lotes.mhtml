CREATE TRIGGER trigger_registra_produto
AFTER INSERT ON produto
FOR EACH ROW
BEGIN
    IF NEW.controle_stock THEN
        INSERT INTO stock (fk_id_produto, fk_id_armazem, saldo)
        SELECT NEW.id, id, 0 FROM armazem;
    END IF;
END;

CREATE TRIGGER trigger_actualiza_stock_fornecido
AFTER INSERT ON produto_fornecido
FOR EACH ROW
BEGIN
    DECLARE total_unidades INT;

    SET total_unidades =3D NEW.quantidade * NEW.qtd_por_unidade;

    INSERT INTO stock (fk_id_produto, fk_id_armazem, saldo)
    VALUES (NEW.fk_id_produto, NEW.fk_id_armazem, total_unidades)
    ON DUPLICATE KEY UPDATE saldo =3D saldo + total_unidades;

    -- Inserir tamb=C3=A9m na tabela movimento
    INSERT INTO movimento (tipo_movimento, data_movimento, quantidade, fk_i=
d_produto, fk_id_usuario, fk_id_armazem, unidade_movimentada, qtd_por_unida=
de)
    VALUES ('Entrada', NEW.data_fornecida, NEW.quantidade, NEW.fk_id_produt=
o, NEW.fk_id_usuario, NEW.fk_id_armazem, NEW.unidade_fornecida, NEW.qtd_por=
_unidade);
END;

CREATE TRIGGER trigger_actualiza_stock_saida
AFTER INSERT ON movimento
FOR EACH ROW
BEGIN
    DECLARE total_unidades INT;

    SET total_unidades =3D NEW.quantidade * NEW.qtd_por_unidade;

    IF NEW.tipo_movimento =3D 'Sa=C3=ADda' THEN
        UPDATE stock
        SET saldo =3D saldo - total_unidades
        WHERE fk_id_produto =3D NEW.fk_id_produto AND fk_id_armazem =3D NEW=
.fk_id_armazem;
    END IF;
END;
