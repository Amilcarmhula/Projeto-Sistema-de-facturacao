-- Trigger actualiza os saldos iniciais e actual de Caixa e ContaCorrente q=
uando transacoes sao registadas;
delimiter //
create trigger _updateCaixa_ContaCorrente
	after insert on transacoes
    for each row
    begin
		DECLARE saldo_anterior DECIMAL(10, 2) DEFAULT 0;
			-- Verifica se o m=C3=A9todo de pagamento =C3=A9 igual a 1 (ajuste confo=
rme necess=C3=A1rio)
            IF NEW.fk_id_metodo_pagamento =3D 1 THEN
				-- Tenta buscar o saldo atual da =C3=BAltima linha da tabela caixa
				SELECT saldo_atual INTO saldo_anterior
					FROM caixa
					ORDER BY id DESC LIMIT 1;

				-- Se n=C3=A3o encontrar saldo anterior, assume que o saldo inicial =C3=
=A9 0
				IF saldo_anterior IS NULL THEN
					SET saldo_anterior =3D 0;
				END IF;

				-- Insere os valores na tabela caixa
				INSERT INTO caixa (saldo_inicial, saldo_atual, fk_id_transacoes)
					VALUES (
					saldo_anterior,                 -- Saldo inicial =C3=A9 o saldo atual =
anterior ou 0 se n=C3=A3o houver
					saldo_anterior + NEW.valorPago,     -- Novo saldo =C3=A9 o saldo anter=
ior somado ao valor da transa=C3=A7=C3=A3o
					NEW.id                         -- FK da transa=C3=A7=C3=A3o inserida
					);
			ELSE
				-- Tenta buscar o saldo atual da =C3=BAltima linha da tabela caixa
				SELECT saldo_atual INTO saldo_anterior
					FROM contacorrente
					ORDER BY id DESC LIMIT 1;

				-- Se n=C3=A3o encontrar saldo anterior, assume que o saldo inicial =C3=
=A9 0
				IF saldo_anterior IS NULL THEN
					SET saldo_anterior =3D 0;
				END IF;

				-- Insere os valores na tabela caixa
				INSERT INTO contacorrente (saldo_inicial, saldo_atual, fk_id_transacoes=
)
					VALUES (
					saldo_anterior,                 -- Saldo inicial =C3=A9 o saldo atual =
anterior ou 0 se n=C3=A3o houver
					saldo_anterior + NEW.valorPago,     -- Novo saldo =C3=A9 o saldo anter=
ior somado ao valor da transa=C3=A7=C3=A3o
					NEW.id                         -- FK da transa=C3=A7=C3=A3o inserida
					);			=09
            END IF;
	end//
