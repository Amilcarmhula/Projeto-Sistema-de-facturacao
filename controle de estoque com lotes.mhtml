-- Procedimento para ajustar e manter o controle dos precos de um produto. =
O procedimento e chamado atraves de um evento que e executado diariamente
DELIMITER //
CREATE PROCEDURE procedure_updatePrecoVenda()
BEGIN
    UPDATE precovenda
    SET estado =3D 'desactivo'
    WHERE data_fim &lt;=3D CURDATE() AND estado =3D 'activo';
END//
DELIMITER ;

-- Eventro para chamar o procedimento procedure_updatePrecoVenda()
CREATE EVENT evento_updatePrecoVenda
	ON SCHEDULE EVERY 1 DAY
	DO
		CALL procedure_updatePrecoVenda();
       =20
-- Procedimento armazenado que e chamado atraves de uma EVENT para controla=
r o estado das parcelas se estao atrasadas ou nao

DELIMITER //
CREATE PROCEDURE procedure_updateEstadoParcela()
BEGIN
    UPDATE parcelas
    SET estado =3D 'Atrasada'
    WHERE dataVencimento &lt;=3D CURDATE() AND estado &lt;&gt; 'Paga';
END//
DELIMITER ;

CREATE EVENT evento_updateEstadoParcela
	ON SCHEDULE EVERY 1 MINUTE
	DO
		CALL procedure_updateEstadoParcela();
   =20

-- Procedimento armazenado que e chamado atraves de uma EVENT para controla=
r a taxa de juros em atraso das parcelas
DELIMITER //
CREATE PROCEDURE procedure_updateTaxaAtrasoParcela()
BEGIN
    UPDATE parcelas
    SET taxaDeAtraso =3D taxaJuros / 2
    WHERE estado =3D 'Atrasada';
END //
DELIMITER ;

CREATE EVENT evento_updateTaxaAtrasoParcela
	ON SCHEDULE EVERY 1 MINUTE
	DO
		CALL procedure_updateTaxaAtrasoParcela();       =20


-- Procedimento armazenado que e chamado atraves de uma EVENT para controla=
r a taxa de juros em atraso das parcelas
delimiter //
CREATE PROCEDURE procedure_updateSaldoFactura_com_Atraso_de_Parcela()
BEGIN
    -- Atualizar o saldo pendente de cada fatura com base nas parcelas
    UPDATE factura f
    SET f.saldoPendente =3D (
        SELECT COALESCE(SUM(
            CASE=20
                WHEN p.estado =3D 'Atrasada' THEN (p.valorParcela * p.taxaD=
eAtraso) + (p.valorParcela - p.valorPagoParcela)
                ELSE=20
					case when p.estado =3D 'Pendente' THEN
						p.valorParcela - p.valorPagoParcela
					end
            END
        ), 0)
        FROM parcelas p
        WHERE p.fk_factura =3D f.numero
    )
    WHERE EXISTS (
        SELECT 1=20
        FROM parcelas p
        WHERE p.fk_factura =3D f.numero
    );
END//
delimiter ;

