                                                            <columnConstraints>
                                                                <ColumnConstraints minWidth="85.0" prefWidth="95.0" />
                                                                <ColumnConstraints hgrow="ALWAYS" minWidth="120.0" />
                                                                <ColumnConstraints minWidth="68.0" prefWidth="78.0" />
                                                                <ColumnConstraints hgrow="ALWAYS" minWidth="95.0" />
                                                            </columnConstraints>
                                                            <children>
                                                                <Label text="ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                                <TextField fx:id="txtIDEndereco" editable="false" focusTraversable="false" promptText="Automático" styleClass="text-squared-border" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                                <Label text="Província" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                                <ComboBox fx:id="combProvincia" maxWidth="1.7976931348623157E308" promptText="Seleccione" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
