                                                            <styleClass>
                                                                <String fx:value="secondary-color" />
                                                                <String fx:value="shadow-efect" />
                                                                <String fx:value="hand-efect" />
                                                            </styleClass>
                                                        </Button>
                                                    </children>
                                                </VBox>
                                            </items>
                                        </SplitPane>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
   <stylesheets>
      <URL value="@../../../../style/dashboard.css" />
      <URL value="@../../../../style/buttonConfig.css" />
   </stylesheets>
</AnchorPane>
