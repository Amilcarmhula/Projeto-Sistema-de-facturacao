-- Trigger para controlar fluxo de stock(saldo de determinado produto em se=
u armazarm) quando um movimento de entrada ou saida e registado na tabela m=
ovimento
DELIMITER //
CREATE TRIGGER trigger_updateSaldoStock
    AFTER INSERT ON movimento
    FOR EACH ROW
BEGIN
    -- Verifica se a combina=C3=A7=C3=A3o de fk_id_produto e fk_id_armazem =
j=C3=A1 existe na tabela stock
    IF NOT EXISTS (
        SELECT 1=20
        FROM stock=20
        WHERE fk_id_produto =3D NEW.fk_id_produto=20
          AND fk_id_armazem =3D NEW.fk_id_armazem
    ) THEN
        -- Insere um novo registro com saldo inicial 0 caso a combina=C3=A7=
=C3=A3o n=C3=A3o exista
        INSERT INTO stock (fk_id_produto, fk_id_armazem, saldo)
        VALUES (NEW.fk_id_produto, NEW.fk_id_armazem, 0);
    END IF;

    -- Atualiza o saldo com base nos movimentos registrados
    UPDATE stock=20
    SET saldo =3D (
        SELECT=20
            (SUM(CASE WHEN tipo_movimento =3D 'Entrada' THEN (quantidade * =
qtd_por_unidade) ELSE 0 END) -=20
             SUM(CASE WHEN tipo_movimento =3D 'Sa=C3=ADda' THEN (quantidade=
 * qtd_por_unidade) ELSE 0 END)) AS saldo_produto
        FROM movimento=20
        WHERE fk_id_produto =3D NEW.fk_id_produto=20
          AND fk_id_armazem =3D NEW.fk_id_armazem
    )
    WHERE fk_id_produto =3D NEW.fk_id_produto=20
      AND fk_id_armazem =3D NEW.fk_id_armazem;
END//
