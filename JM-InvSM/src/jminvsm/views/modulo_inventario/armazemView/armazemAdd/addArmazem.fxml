                                                                <Label text="Responsável" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                                <TextField fx:id="txtResponsavel" promptText="Pessoa de contacto" styleClass="text-squared-border" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                                <Label text="Telefone" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                                <TextField fx:id="txtContacto" promptText="Número de telefone" styleClass="text-squared-border" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                                <Label text="E-mail" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                                <TextField fx:id="txtEmail" promptText="email@empresa.co.mz" styleClass="text-squared-border" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                            </children>
                                             <rowConstraints>
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                             </rowConstraints>
                                                        </GridPane>
                                                        <Button fx:id="btnAddContacto" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addORupdateContacto" prefHeight="38.0" text="Guardar contacto" textFill="WHITE">
                                                            <font><Font name="System Bold" size="14.0" /></font>
                                                            <styleClass>
                                                                <String fx:value="secondary-color" />
                                                                <String fx:value="shadow-efect" />
                                                                <String fx:value="hand-efect" />
                                                            </styleClass>
                                                        </Button>
                                                    </children>
                                                </VBox>
                                            </items>
                                        </SplitPane>
                                    </children>
                                </VBox>

                                <!-- ENDEREÇOS -->
                                <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dfe7ea; -fx-border-radius: 8;">
                                    <padding><Insets bottom="16.0" left="18.0" right="18.0" top="14.0" /></padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="Endereços do armazém">
                                                            <font><Font name="System Bold" size="18.0" /></font>
                                                        </Label>
                                                        <Label opacity="0.7" text="Seleccione uma linha para editar; clique com o botão direito para remover." />
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#resetEndereco" text="Novo endereço" />
                                            </children>
                                        </HBox>
                                        <Separator />
                                        <SplitPane dividerPositions="0.61" prefHeight="240.0" prefWidth="1019.0">
                                            <items>
                                                <TableView fx:id="tabelaEndereco" onMouseClicked="#selecionaEndereco" prefHeight="285.0" style="-fx-border-color: transparent;">
                                                    <columns>
                                                        <TableColumn fx:id="IDtabelaEndereco" minWidth="42.0" prefWidth="48.0" text="ID" />
                                                        <TableColumn fx:id="provinciatabelaEndereco" minWidth="105.0" prefWidth="130.0" text="Província" />
                                                        <TableColumn fx:id="cidadetabelaEndereco" minWidth="90.0" prefWidth="115.0" text="Cidade" />
                                                        <TableColumn fx:id="bairrotabelaEndereco" minWidth="95.0" prefWidth="125.0" text="Bairro" />
                                                        <TableColumn fx:id="avenidatabelaEndereco" minWidth="95.0" prefWidth="125.0" text="Avenida" />
                                                        <TableColumn fx:id="ruatabelaEndereco" minWidth="80.0" prefWidth="105.0" text="Rua" />
                                                        <TableColumn fx:id="codigopostaltabelaEndereco" minWidth="90.0" prefWidth="105.0" text="Cód. postal" />
                                                        <TableColumn fx:id="numerotabelaEndereco" minWidth="62.0" prefWidth="75.0" text="Número" />
                                                    </columns>
