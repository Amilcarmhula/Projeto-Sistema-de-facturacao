import java.awt.print.*;

public class ImpressaoGrafica implements Printable {

    public int print(Graphics g, PageFormat pf, int pageIndex) {
        if (pageIndex &gt; 0) return NO_SUCH_PAGE;

        Graphics2D g2d =3D (Graphics2D) g;
        g2d.translate(pf.getImageableX(), pf.getImageableY());

        // Texto com fonte personalizada
        g.setFont(new Font("Arial", Font.BOLD, 14));
        g.drawString("Recibo de Pagamento", 100, 100);

        g.setFont(new Font("Arial", Font.PLAIN, 12));
        g.drawString("Produto A - 2x 10,00", 100, 130);
        g.drawString("Produto B - 1x 25,00", 100, 150);

        g.setFont(new Font("Arial", Font.BOLD, 12));
        g.drawString("TOTAL: 45,00", 100, 180);

        return PAGE_EXISTS;
    }

    public static void main(String[] args) {
        PrinterJob job =3D PrinterJob.getPrinterJob();
        job.setPrintable(new ImpressaoGrafica());

        if (job.printDialog()) { // Abre a caixa de di=C3=A1logo
            try {
                job.print();
            } catch (PrinterException e) {
                e.printStackTrace();
            }
        }
    }
}
